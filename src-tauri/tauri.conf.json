{
  "productName": "Space Power",
  "version": "1.0.0",
  "identifier": "is.siggi.spacepower",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Space Power",
        "url": "space_power_10.html",
        "width": 700,
        "height": 700,
        "resizable": false,
        "center": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
